# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres 'postgres' user password — used by both containers in docker-compose.yml.
POSTGRES_PASSWORD=Change-Me-1!

# Seeds the first admin account on startup (Program.cs). Required in Production.
Admin__Email=admin@frontida4all.gr
Admin__Password=Change-Me-Too-1!

# Claude API key for AI content moderation (Services/ClaudeModerationService.cs).
Moderation__ClaudeApiKey=sk-ant-...

# Gmail SMTP credentials used for all outgoing email (Services/SmtpEmailService.cs).
Email__SmtpUser=frontida4all@gmail.com
Email__SmtpPass=your-gmail-app-password

# Stripe (Controllers/SubscriptionController.cs). Use test keys until ready to go live.
Stripe__SecretKey=sk_test_...
Stripe__WebhookSecret=whsec_...
Stripe__PaidPriceId=price_...

# Company details for local invoice records (Services/CompanyOptions.cs) —
# replace VatNumber once the real company registration is finalised.
Company__VatNumber=88888888

# Optional social login — omit any provider you don't use, it's skipped automatically.
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
# Authentication__Facebook__AppId=
# Authentication__Facebook__AppSecret=
# Authentication__Microsoft__ClientId=
# Authentication__Microsoft__ClientSecret=
