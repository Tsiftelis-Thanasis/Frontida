@{
    ViewData["Title"] = L["SubTitle"].Value;
    var currentPlan       = (frontida4baby.Web.Models.Entities.SubscriptionPlan)ViewBag.CurrentPlan;
    var stripeEnabled     = (bool)ViewBag.StripeEnabled;
    var hasStripeCustomer = ViewBag.HasStripeCustomer as bool? ?? false;
    var refundEligible    = ViewBag.RefundEligible as bool? ?? false;
    var refundWindowDays  = ViewBag.RefundWindowDays as int? ?? 14;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">@L["SubHeading"]</h1>
        <p class="lead text-muted">@L["SubSubtitle"]</p>
    </div>

    <div class="row justify-content-center g-4">
        <!-- Free Plan -->
        <div class="col-md-5">
            <div class="card h-100 @(currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Free ? "border-success border-2" : "")">
                <div class="card-header text-center py-3">
                    <h3 class="mb-0">@L["SubFreePlanName"]</h3>
                    <div class="display-6 fw-bold mt-2">€0<small class="fs-6 text-muted">@L["SubPerMonth"]</small></div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubFreeFeature1"]</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubFreeFeature2"]</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubFreeFeature3"]</li>
                        <li class="mb-2 text-muted"><i class="fas fa-times text-danger me-2"></i>@L["SubFreeFeature4"]</li>
                    </ul>
                </div>
                <div class="card-footer text-center pb-3">
                    @if (currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Free)
                    {
                        <span class="btn btn-success disabled w-100">@L["SubCurrentPlan"]</span>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary w-100">@L["SubBasicLabel"]</span>
                    }
                </div>
            </div>
        </div>

        <!-- Paid Plan -->
        <div class="col-md-5">
            <div class="card h-100 border-primary border-2 @(currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Paid ? "border-success" : "")">
                <div class="card-header text-center py-3 bg-primary text-white">
                    <h3 class="mb-0">Premium</h3>
                    <div class="display-6 fw-bold mt-2">€13<small class="fs-6">@L["SubPerMonth"]</small></div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubPaidFeature1"]</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubPaidFeature2"]</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubPaidFeature3"]</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@L["SubPaidFeature4"]</li>
                    </ul>
                </div>
                <div class="card-footer text-center pb-3">
                    @if (currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Paid)
                    {
                        <span class="btn btn-success disabled w-100">@L["SubCurrentPlan"]</span>
                    }
                    else if (!stripeEnabled)
                    {
                        <span class="btn btn-secondary disabled w-100">
                            <i class="fas fa-clock me-2"></i>Σύντομα διαθέσιμο
                        </span>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="Checkout" asp-controller="Subscription" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-crown me-2"></i>@L["SubUpgradeBtn"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                            <i class="fas fa-crown me-2"></i>@L["SubLoginToUpgrade"]
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Paid && stripeEnabled)
    {
        <div class="row justify-content-center mt-4">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-body">
                        <h5 class="mb-3">Διαχείριση Συνδρομής</h5>

                        @if (TempData["SubscriptionMessage"] != null)
                        {
                            <div class="alert alert-success">@TempData["SubscriptionMessage"]</div>
                        }
                        @if (TempData["SubscriptionError"] != null)
                        {
                            <div class="alert alert-warning">@TempData["SubscriptionError"]</div>
                        }

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Billing" class="btn btn-outline-secondary">
                                <i class="fas fa-file-invoice me-2"></i>Ιστορικό Πληρωμών
                            </a>

                            @if (hasStripeCustomer)
                            {
                                <a asp-action="Portal" class="btn btn-outline-secondary">
                                    <i class="fas fa-credit-card me-2"></i>Διαχείριση Χρέωσης
                                </a>
                            }

                            @if (refundEligible)
                            {
                                <form asp-action="Refund" method="post"
                                      onsubmit="return confirm('Να ακυρωθεί η συνδρομή και να επιστραφεί ολόκληρο το ποσό της τρέχουσας χρέωσης;');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="fas fa-undo me-2"></i>Ακύρωση &amp; Πλήρης Επιστροφή (εντός @refundWindowDays ημερών)
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary disabled" title="Η επιστροφή είναι διαθέσιμη μόνο εντός @refundWindowDays ημερών από τη χρέωση, μία φορά ανά περίοδο χρέωσης.">
                                    <i class="fas fa-undo me-2"></i>Επιστροφή μη διαθέσιμη
                                </span>
                                <a asp-controller="Home" asp-action="Support" class="btn btn-link">Επικοινωνία για βοήθεια</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
