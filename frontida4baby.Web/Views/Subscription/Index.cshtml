@{
    ViewData["Title"] = "Subscription Plans";
    var currentPlan = (frontida4baby.Web.Models.Entities.SubscriptionPlan)ViewBag.CurrentPlan;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Επιλέξτε Πλάνο</h1>
        <p class="lead text-muted">Ξεκινήστε δωρεάν ή αναβαθμίστε για απεριόριστη πρόσβαση</p>
    </div>

    <div class="row justify-content-center g-4">
        <!-- Free Plan -->
        <div class="col-md-5">
            <div class="card h-100 @(currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Free ? "border-success border-2" : "")">
                <div class="card-header text-center py-3">
                    <h3 class="mb-0">Δωρεάν</h3>
                    <div class="display-6 fw-bold mt-2">€0<small class="fs-6 text-muted">/μήνα</small></div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Έως 5 αγγελίες/μήνα</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Έως 20 απαντήσεις/μήνα</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Έως 10 reactions/μήνα</li>
                        <li class="mb-2 text-muted"><i class="fas fa-times text-danger me-2"></i>Τηλέφωνα χρηστών</li>
                    </ul>
                </div>
                <div class="card-footer text-center pb-3">
                    @if (currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Free)
                    {
                        <span class="btn btn-success disabled w-100">Τρέχον Πλάνο</span>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary w-100">Βασικό</span>
                    }
                </div>
            </div>
        </div>

        <!-- Paid Plan -->
        <div class="col-md-5">
            <div class="card h-100 border-primary border-2 @(currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Paid ? "border-success" : "")">
                <div class="card-header text-center py-3 bg-primary text-white">
                    <h3 class="mb-0">Premium</h3>
                    <div class="display-6 fw-bold mt-2">€10<small class="fs-6">/μήνα</small></div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Απεριόριστες αγγελίες</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Απεριόριστες απαντήσεις</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Απεριόριστα reactions</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Εμφάνιση τηλεφώνων</li>
                    </ul>
                </div>
                <div class="card-footer text-center pb-3">
                    @if (currentPlan == frontida4baby.Web.Models.Entities.SubscriptionPlan.Paid)
                    {
                        <span class="btn btn-success disabled w-100">Τρέχον Πλάνο</span>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="Checkout" asp-controller="Subscription" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-crown me-2"></i>Αναβάθμιση σε Premium
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/account/login" class="btn btn-primary w-100">
                            <i class="fas fa-crown me-2"></i>Συνδεθείτε για Αναβάθμιση
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
