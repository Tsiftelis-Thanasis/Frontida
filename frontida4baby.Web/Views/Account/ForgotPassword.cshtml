@model frontida4baby.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fa-solid fa-lock fa-2x text-primary mb-3 d-block"></i>
            <h2>Forgot Password</h2>
            <p class="subtitle">Enter your email and we'll send you a reset link.</p>
        </div>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email"
                       placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-auth">Send Reset Link</button>
        </form>

        <p class="text-center mt-4 mb-0 small" style="color:var(--c-muted)">
            Remember your password?
            <a asp-controller="Account" asp-action="Login"
               class="fw-bold" style="color:var(--c-primary)">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
