@model frontida4baby.Web.Models.ViewModels.LoginViewModel
@using Microsoft.AspNetCore.Authentication
@{
    ViewData["Title"] = L["LoginTitle"].Value;
    var providers = ViewData["ExternalProviders"] as List<AuthenticationScheme> ?? new();
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fa-solid fa-heart fa-2x text-primary mb-3 d-block"></i>
            <h2>@L["LoginTitle"]</h2>
            <p class="subtitle">@L["LoginSubtitle"]</p>
        </div>

        @if (providers.Count > 0)
        {
            <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div class="d-grid gap-2 mb-2">
                    @foreach (var p in providers)
                    {
                        var (iconClass, btnClass) = p.Name switch
                        {
                            "Google"          => ("fa-brands fa-google",    "btn-google"),
                            "Facebook"        => ("fa-brands fa-facebook-f","btn-facebook"),
                            "Microsoft"       => ("fa-brands fa-microsoft", "btn-microsoft"),
                            "Apple"           => ("fa-brands fa-apple",     "btn-apple"),
                            _                 => ("fa-solid fa-key",        "btn-outline-secondary")
                        };
                        <button type="submit" name="provider" value="@p.Name"
                                class="btn btn-social @btnClass w-100">
                            <i class="@iconClass"></i>
                            @p.DisplayName
                        </button>
                    }
                </div>
            </form>
            <div class="social-divider">@L["SocialOrDivider"]</div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

            <div class="mb-3">
                <label class="form-label">@L["LoginEmail"]</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email"
                       placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">@L["LoginPassword"]</label>
                <input asp-for="Password" class="form-control" type="password"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">@L["LoginRemember"]</label>
                </div>
            </div>

            <button type="submit" class="btn-auth">@L["LoginBtn"]</button>
        </form>

        <p class="text-center mt-4 mb-0 small" style="color:var(--c-muted)">
            @L["LoginNoAccount"]
            <a asp-controller="Account" asp-action="Register"
               class="fw-bold" style="color:var(--c-primary)">@L["LoginRegisterLink"]</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
