@model List<frontida4baby.Web.Models.Entities.ModerationLog>
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = "Moderation Audit Log";
}

<div class="container py-4">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Audit Log</h2>
    <a asp-action="Queue" class="btn btn-outline-secondary btn-sm">← Back to Queue</a>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover">
        <thead class="table-light">
            <tr>
                <th>When</th>
                <th>Type</th>
                <th>Decision</th>
                <th>Stage</th>
                <th>Category</th>
                <th>Reason</th>
                <th>Confidence</th>
                <th>Content (excerpt)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                var rowClass = log.Decision switch
                {
                    ModerationStatus.Approved     => "",
                    ModerationStatus.Rejected     => "table-danger",
                    ModerationStatus.PendingReview => "table-warning",
                    _                             => "",
                };
                <tr class="@rowClass">
                    <td><small>@log.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</small></td>
                    <td><small>@log.ContentType #@log.ContentId</small></td>
                    <td><small class="fw-semibold">@log.Decision</small></td>
                    <td><small>@log.Stage</small></td>
                    <td><small>@log.ViolationCategory</small></td>
                    <td><small>@log.Reason</small></td>
                    <td><small>@(log.ConfidenceScore.HasValue ? $"{log.ConfidenceScore:P0}" : "—")</small></td>
                    <td>
                        <small class="text-muted" title="@log.OriginalContent">
                            @(log.OriginalContent.Length > 80
                                ? log.OriginalContent[..80] + "…"
                                : log.OriginalContent)
                        </small>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>@* /container *@
