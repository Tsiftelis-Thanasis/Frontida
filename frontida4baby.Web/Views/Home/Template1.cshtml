@{
    ViewData["Title"] = "Template 1 – Light Teal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .t1-hero {
        background: linear-gradient(135deg, #0d9488 55%, #f0fdfa 55%);
        padding: 80px 0 60px;
    }
    .t1-hero h1 { font-size: 2.8rem; font-weight: 800; color: #fff; line-height: 1.2; }
    .t1-hero p  { color: rgba(255,255,255,0.9); font-size: 1.1rem; margin: 1.2rem 0 2rem; }
    .t1-btn-primary   { background: #fff; color: #0d9488; border: none; padding: 12px 28px; border-radius: 8px; font-weight: 600; text-decoration: none; }
    .t1-btn-primary:hover { background: #f0fdfa; color: #0d9488; }
    .t1-btn-outline   { background: transparent; color: #fff; border: 2px solid #fff; padding: 10px 26px; border-radius: 8px; font-weight: 600; text-decoration: none; margin-left: 12px; }
    .t1-btn-outline:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .t1-hero-img { border-radius: 16px; width: 100%; max-height: 400px; object-fit: cover; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
    .t1-features { padding: 80px 0; background: #fff; }
    .t1-features h2 { font-size: 2rem; font-weight: 800; text-align: center; margin-bottom: 0.5rem; }
    .t1-features .t1-sub { text-align: center; color: #6b7280; margin-bottom: 3rem; }
    .t1-feature-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 28px; height: 100%; transition: box-shadow 0.2s; }
    .t1-feature-card:hover { box-shadow: 0 8px 30px rgba(13,148,136,0.15); }
    .t1-icon-wrap { width: 52px; height: 52px; border-radius: 50%; background: #ccfbf1; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .t1-icon-wrap i { color: #0d9488; font-size: 1.25rem; }
    .t1-feature-card h5 { font-weight: 700; margin-bottom: 8px; }
    .t1-feature-card p  { color: #6b7280; font-size: 0.92rem; margin: 0; }
</style>

<section class="t1-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1>Find Trusted Care<br>for Your Family</h1>
                <p>Connect with verified babysitters, nannies, tutors and eldercare specialists across Greece — fast, safe and simple.</p>
                <a href="#" class="t1-btn-primary">Browse Caregivers</a>
                <a href="#" class="t1-btn-outline">Learn More</a>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=600"
                     alt="Caregiver with dog" class="t1-hero-img">
            </div>
        </div>
    </div>
</section>

<section class="t1-features">
    <div class="container">
        <h2>Saving <span style="color:#0d9488">Caregiving</span> Features</h2>
        <p class="t1-sub">Everything families need to find the right care, all in one place.</p>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="t1-feature-card">
                    <div class="t1-icon-wrap"><i class="fas fa-users"></i></div>
                    <h5>Family Profiles</h5>
                    <p>Create a detailed family profile so caregivers know exactly what you need.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="t1-feature-card">
                    <div class="t1-icon-wrap"><i class="fas fa-list-check"></i></div>
                    <h5>Easy Listings</h5>
                    <p>Post your care request in minutes and reach hundreds of local professionals.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="t1-feature-card">
                    <div class="t1-icon-wrap"><i class="fas fa-shield-heart"></i></div>
                    <h5>Quality Care</h5>
                    <p>Every caregiver is vetted and verified before they appear on the platform.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="t1-feature-card">
                    <div class="t1-icon-wrap"><i class="fas fa-star"></i></div>
                    <h5>Reviews &amp; Ratings</h5>
                    <p>Read honest reviews from other families before making your decision.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="t1-feature-card">
                    <div class="t1-icon-wrap"><i class="fas fa-calendar-check"></i></div>
                    <h5>Flexible Booking</h5>
                    <p>Schedule one-time or recurring appointments that fit your family's calendar.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="t1-feature-card">
                    <div class="t1-icon-wrap"><i class="fas fa-comment-dots"></i></div>
                    <h5>Secure Messaging</h5>
                    <p>Chat directly with caregivers through our safe, in-app messaging system.</p>
                </div>
            </div>
        </div>
    </div>
</section>
