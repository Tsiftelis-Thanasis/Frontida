@{
    ViewData["Title"] = L["HeroTitle"].Value;
    var services = new[]
    {
        (Key: "Childcare",    Chip: "ChipChildcare",    Title: "SvcChildcareTitle",    Desc: "SvcChildcareDesc",    Img: "childcare",    Tint: "childcare",    Dot: "childcare"),
        (Key: "ElderlyCare",  Chip: "ChipElderly",      Title: "SvcElderlyTitle",      Desc: "SvcElderlyDesc",      Img: "elderly",      Tint: "elderly",      Dot: "elderly"),
        (Key: "Tutoring",     Chip: "ChipTutoring",     Title: "SvcTutoringTitle",     Desc: "SvcTutoringDesc",     Img: "tutoring",     Tint: "tutoring",     Dot: "tutoring"),
        (Key: "Housekeeping", Chip: "ChipHousekeeping", Title: "SvcHousekeepingTitle", Desc: "SvcHousekeepingDesc", Img: "housekeeping", Tint: "housekeeping", Dot: "housekeeping"),
        (Key: "PetCare",      Chip: "ChipPets",         Title: "SvcPetTitle",          Desc: "SvcPetDesc",          Img: "pets",         Tint: "pets",         Dot: "pets"),
    };
    var heroTitle = L["HeroTitle"].Value;
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

@* ─── Hero ─────────────────────────────────────────────────────────────────── *@
<section class="hm-wrap hm-hero">
    <div class="hm-hero-copy">
        <div class="hm-badge">@L["HomeBadge"]</div>
        <h1>@heroTitle</h1>
        <p class="hm-lead">@L["HomeHeroLead"]</p>

        <form class="hm-search" method="get" asp-controller="Caregivers" asp-action="Index">
            <div class="hm-search-label">@L["HomeWhatHelp"]</div>
            <div class="hm-chips" role="radiogroup">
                @foreach (var s in services)
                {
                    <label class="hm-chip" style="--dot:var(--st-dot-@s.Dot)">
                        <input type="radio" name="ServiceType" value="@s.Key" @(s.Key == "ElderlyCare" ? "checked" : null) />
                        <span>@L[s.Chip]</span>
                    </label>
                }
            </div>
            <div class="hm-search-row">
                <label class="hm-field">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A8174" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
                    <input type="text" name="City" placeholder="@L["HomeCityPlaceholder"]" />
                </label>
                <button type="submit" class="hm-go">@L["HomeSeeCaregivers"] <span aria-hidden="true">→</span></button>
            </div>
        </form>

        <div class="hm-trust">
            <span><b>✓</b>@L["HomeTrustVerified"]</span>
            <span><b>✓</b>@L["HomeTrustNationwide"]</span>
        </div>
    </div>

    <div class="hm-hero-visual">
        <div class="hm-arch"><img src="~/images/home/elderly.jpg" alt="" /></div>
        <div class="hm-circle"><img src="~/images/home/childcare.jpg" alt="" /></div>
        <div class="hm-float">
            <span class="tick">✓</span>
            <span>@L["HomeFloatTitle"]<br /><small>@L["HomeFloatSub"]</small></span>
        </div>
    </div>
</section>

@* ─── Services ─────────────────────────────────────────────────────────────── *@
<section class="hm-services">
    <div class="hm-wrap hm-services-inner">
        <div class="hm-sec-head">
            <div>
                <div class="hm-eyebrow">@L["HomeSvcEyebrow"]</div>
                <h2>@L["HomeSvcHeadA"]<br /><em>@L["HomeSvcHeadB"]</em></h2>
            </div>
            <p>@L["SvcSubtitle"]</p>
        </div>

        <div class="hm-svc-grid">
            @foreach (var s in services)
            {
                <a class="hm-svc" style="--tint:var(--st-tint-@s.Tint)"
                   asp-controller="Caregivers" asp-action="Index" asp-route-ServiceType="@s.Key">
                    <div class="hm-svc-img"><img src="~/images/home/@(s.Img).jpg" alt="" loading="lazy" /></div>
                    <div class="hm-svc-body">
                        <h3>@L[s.Title]</h3>
                        <p>@L[s.Desc]</p>
                        <span class="hm-svc-cta">@L["NavBrowse"] <i>→</i></span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@* ─── CTA panels ───────────────────────────────────────────────────────────── *@
<section class="hm-cta-band">
    <div class="hm-wrap hm-cta-grid">
        <div class="hm-cta hm-cta-families">
            <div class="eyebrow">@L["HomeFamiliesEyebrow"]</div>
            <h3>@L["HomeFamiliesTitle"]</h3>
            <p>@L["HomeFamiliesText"]</p>
            <div class="hm-cta-actions">
                <a class="hm-btn hm-btn-solid" asp-controller="Caregivers" asp-action="Index">@L["HomeViewProfiles"] →</a>
                <a class="hm-btn hm-btn-ghost" asp-controller="Posts" asp-action="Index">@L["NavFindHelp"]</a>
            </div>
        </div>
        <div class="hm-cta hm-cta-caregivers">
            <div class="eyebrow">@L["HomeCaregiversEyebrow"]</div>
            <h3>@L["HomeCaregiversTitle"]</h3>
            <p>@L["HomeCaregiversText"]</p>
            <div class="hm-cta-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="hm-btn hm-btn-terra" asp-controller="Dashboard" asp-action="Index">@L["NavDashboard"] →</a>
                }
                else
                {
                    <a class="hm-btn hm-btn-terra" asp-controller="Account" asp-action="Register">@L["HomeCreateAccount"] →</a>
                }
            </div>
        </div>
    </div>
</section>
