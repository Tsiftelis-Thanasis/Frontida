<script>
(function() {
    const testimonials = document.querySelectorAll('.t4-carousel-slide');
    const totalTestimonials = testimonials.length;
    let currentIndex = 0;

    // Create dots
    const dotsContainer = document.getElementById('dotsContainer');
    for (let i = 0; i < totalTestimonials; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 't4-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', `Testimonial ${i + 1}`);
        dot.setAttribute('data-index', i);
        dot.addEventListener('click', () => goToSlide(i));
        dotsContainer.appendChild(dot);
    }

    function showSlide(index) {
        testimonials.forEach((slide, i) => {
            if (i === index) {
                slide.classList.add('active');
            } else {
                slide.classList.remove('active');
            }
        });

        document.querySelectorAll('.t4-dot').forEach((dot, i) => {
            if (i === index) {
                dot.classList.add('active');
            } else {
                dot.classList.remove('active');
            }
        });
    }

    function goToSlide(index) {
        currentIndex = (index + totalTestimonials) % totalTestimonials;
        showSlide(currentIndex);
    }

    function nextSlide() {
        currentIndex = (currentIndex + 1) % totalTestimonials;
        showSlide(currentIndex);
    }

    function prevSlide() {
        currentIndex = (currentIndex - 1 + totalTestimonials) % totalTestimonials;
        showSlide(currentIndex);
    }

    document.getElementById('nextBtn').addEventListener('click', nextSlide);
    document.getElementById('prevBtn').addEventListener('click', prevSlide);

    // Optional: Auto-rotate testimonials every 6 seconds
    setInterval(nextSlide, 6000);
})();
</script>
