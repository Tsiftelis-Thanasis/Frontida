@{
    ViewData["Title"] = "Template 2 – Dark Minimal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .t2-page { background: #111827; color: #f9fafb; }
    .t2-hero { padding: 90px 0 70px; }
    .t2-hero h1 { font-size: 3rem; font-weight: 800; color: #fff; line-height: 1.15; }
    .t2-hero p  { color: #9ca3af; font-size: 1.1rem; margin: 1.4rem 0 2.2rem; max-width: 480px; }
    .t2-btn-primary { background: #3b82f6; color: #fff; border: none; padding: 13px 30px; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 1rem; }
    .t2-btn-primary:hover { background: #2563eb; color: #fff; }
    .t2-hero-img { border-radius: 16px; width: 100%; max-height: 420px; object-fit: cover; }
    .t2-features { padding: 70px 0 90px; }
    .t2-features h2 { font-size: 1.9rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; }
    .t2-features .t2-sub { color: #9ca3af; margin-bottom: 3rem; }
    .t2-feature-card { background: #1f2937; border: 1px solid #374151; border-radius: 12px; padding: 28px 24px; height: 100%; }
    .t2-avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; margin-bottom: 16px; }
    .t2-feature-card h5 { font-weight: 700; color: #f9fafb; margin-bottom: 8px; }
    .t2-feature-card p  { color: #9ca3af; font-size: 0.92rem; margin: 0; }
    .t2-badge { display: inline-block; background: #374151; color: #d1d5db; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; margin-bottom: 12px; }
</style>

<div class="t2-page">
    <section class="t2-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <span class="t2-badge"><i class="fas fa-shield-halved me-1"></i> Verified Platform</span>
                    <h1>Quality Care,<br>Trusted Hands</h1>
                    <p>Frontida connects Greek families with verified caregivers — babysitters, tutors, eldercare and more — all in one secure platform.</p>
                    <a href="#" class="t2-btn-primary">Get Started Free</a>
                </div>
                <div class="col-lg-6">
                    <img src="https://images.unsplash.com/photo-1530541930197-ff16ac917b0e?w=600"
                         alt="Family" class="t2-hero-img">
                </div>
            </div>
        </div>
    </section>

    <section class="t2-features">
        <div class="container">
            <h2 class="text-center">Frontida connects to <span style="color:#3b82f6">Everyone</span></h2>
            <p class="t2-sub text-center">A platform built for every member of the family.</p>
            <div class="row g-4 justify-content-center">
                <div class="col-md-3 col-sm-6">
                    <div class="t2-feature-card text-center">
                        <img src="https://images.unsplash.com/photo-1511895426328-dc8714191011?w=150"
                             alt="Family" class="t2-avatar mx-auto d-block">
                        <h5>Family Profiles</h5>
                        <p>Create your family profile and describe exactly what care you need.</p>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="t2-feature-card text-center">
                        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=150"
                             alt="Service" class="t2-avatar mx-auto d-block">
                        <h5>Service Listings</h5>
                        <p>Browse hundreds of caregivers by city, service type and availability.</p>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="t2-feature-card text-center">
                        <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=150"
                             alt="Booking" class="t2-avatar mx-auto d-block">
                        <h5>Booking System</h5>
                        <p>Schedule one-time or recurring care sessions with a few clicks.</p>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="t2-feature-card text-center">
                        <img src="https://images.unsplash.com/photo-1554151228-14d9def656e4?w=150"
                             alt="Savings" class="t2-avatar mx-auto d-block">
                        <h5>Account Savings</h5>
                        <p>Track spending, manage bookings and save favourite caregivers.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
