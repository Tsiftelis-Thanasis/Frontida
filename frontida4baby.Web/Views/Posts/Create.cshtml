@model frontida4baby.Web.Models.ViewModels.CreatePostViewModel
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = L["CreatePostTitle"].Value;
}

<div class="container py-5">
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="mb-3">@L["CreatePostHeading"]</h2>

        <div class="alert alert-warning" role="alert">
            <strong>@L["CreatePolicyTitle"]</strong><br />
            @L["CreatePolicyBody"]
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control"
                       placeholder="@L["CreatePostTitlePlaceholder"]" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label"></label>
                <textarea asp-for="Body" class="form-control" rows="6"
                          placeholder="@L["CreatePostBodyPlaceholder"]"></textarea>
                <span asp-validation-for="Body" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="ServiceType" class="form-label"></label>
                    <select asp-for="ServiceType" class="form-select"
                            asp-items="Html.GetEnumSelectList<ServiceType>()">
                        <option value="">@L["SelectOptional"]</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" placeholder="Athens" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@L["CreatePostSubmit"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@L["BtnCancel"]</a>
            </div>
        </form>
    </div>
</div>
</div>@* /container *@

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
