@model frontida4baby.Web.Models.ViewModels.CreatePostViewModel
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = "Επεξεργασία Αγγελίας";
    var postId = ViewBag.PostId as int? ?? 0;
    var editedAt = ViewBag.EditedAt as DateTime?;
}

<div class="container py-5">
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="mb-3">Επεξεργασία Αγγελίας</h2>

        @if (editedAt.HasValue)
        {
            <div class="alert alert-secondary small">
                <i class="fas fa-clock me-1"></i>
                Τελευταία επεξεργασία: @editedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
            </div>
        }

        <div class="alert alert-warning" role="alert">
            <strong>Κοινοτική Πολιτική</strong><br />
            Οι αλλαγές ελέγχονται αυτόματα πριν την δημοσίευση.
        </div>

        <form asp-action="Edit" asp-route-id="@postId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label"></label>
                <textarea asp-for="Body" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Body" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="ServiceType" class="form-label"></label>
                    <select asp-for="ServiceType" class="form-select"
                            asp-items="Html.GetEnumSelectList<ServiceType>()">
                        <option value="">-- Προαιρετικό --</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Αποθήκευση Αλλαγών</button>
                <a asp-action="Details" asp-route-id="@postId" class="btn btn-outline-secondary">Ακύρωση</a>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
