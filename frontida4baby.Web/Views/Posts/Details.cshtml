@model frontida4baby.Web.Models.ViewModels.PostDetailViewModel
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container py-4">
<div class="row">
    <div class="col-lg-8">

        @* Status messages *@
        @if (TempData["ReplyStatus"] as string == "Approved")
        {
            <div class="alert alert-success alert-dismissible fade show">
                @L["PostReplyApproved"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ReplyStatus"] as string == "Pending")
        {
            <div class="alert alert-info alert-dismissible fade show">
                @L["PostReplyPending"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ReplyEditError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ReplyEditError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* Moderation status banners (only on active posts) *@
        @if (Model.Status == PostStatus.Active && Model.ModerationStatus == ModerationStatus.PendingReview)
        {
            <div class="alert alert-warning">
                <i class="fas fa-clock me-2"></i>
                <strong>@L["PostPendingReview"]:</strong> @L["PostPendingBannerMsg"]
            </div>
        }
        @if (Model.Status == PostStatus.Active && Model.ModerationStatus == ModerationStatus.Rejected)
        {
            <div class="alert alert-danger">
                <i class="fas fa-ban me-2"></i>
                <strong>@L["PostRejected"]:</strong> @L["PostRejectedBannerMsg"]
            </div>
        }

        @* Post *@
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="card-title">@Model.Title</h3>
                <div class="mb-2">
                    @if (Model.ServiceType.HasValue)
                    {
                        <span class="badge bg-secondary me-1">@Model.ServiceType</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.City))
                    {
                        <span class="badge bg-light text-dark border me-1">📍 @Model.City</span>
                    }
                </div>
                <p class="card-text" style="white-space: pre-wrap">@Model.Body</p>
                <small class="text-muted">
                    @L["PostBy"] @Model.AuthorName
                    @if (Model.AuthorIsCaregiver && Model.AuthorAverageRating > 0)
                    {
                        @await Html.PartialAsync("_StarRating", Model.AuthorAverageRating,
                            new ViewDataDictionary(ViewData) { ["StarCount"] = Model.AuthorReviewCount })
                    }
                    · @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    @if (Model.EditedAt.HasValue)
                    {
                        <span class="ms-1 fst-italic">@L["PostEditedLabel"]</span>
                    }
                </small>

                @if (Model.AuthorIsCaregiver && Model.CanSeeRatingDetails && Model.AuthorReviews.Any())
                {
                    <div class="mt-3 border-top pt-3">
                        <p class="small fw-semibold text-muted mb-2">Αξιολογήσεις φροντιστή</p>
                        @foreach (var rv in Model.AuthorReviews)
                        {
                            <div class="mb-2">
                                @await Html.PartialAsync("_StarRating", (double)rv.Rating,
                                    new ViewDataDictionary(ViewData))
                                <span class="small ms-1 fw-semibold">@rv.ReviewerName</span>
                                <span class="small text-muted ms-1">· @rv.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                @if (!string.IsNullOrEmpty(rv.Comment))
                                {
                                    <div class="small text-muted fst-italic ms-1">@rv.Comment</div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                    @if (Model.ModerationStatus == ModerationStatus.Approved)
                    {
                        @* Reaction button *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button id="react-btn" class="btn btn-sm @(Model.CurrentUserLiked ? "btn-primary" : "btn-outline-primary")"
                                    data-post-id="@Model.PostId" data-liked="@Model.CurrentUserLiked.ToString().ToLower()">
                                <i class="fas fa-heart me-1"></i>
                                <span id="react-count">@Model.ReactionCount</span>
                            </button>
                            @* Save button *@
                            <button id="save-btn" class="btn btn-sm @(Model.CurrentUserSaved ? "btn-warning" : "btn-outline-warning")"
                                    data-post-id="@Model.PostId" data-saved="@Model.CurrentUserSaved.ToString().ToLower()">
                                <i class="fas fa-bookmark me-1"></i>
                                @(Model.CurrentUserSaved ? L["BtnSaved"].Value : L["BtnSave"].Value)
                            </button>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-outline-primary disabled">
                                <i class="fas fa-heart me-1"></i>@Model.ReactionCount
                            </span>
                        }
                    }

                    @* Edit post (author only) *@
                    @if (Model.CanEdit && Model.Status == PostStatus.Active)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.PostId"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-edit me-1"></i>@L["BtnEdit"]
                        </a>
                    }

                    @* Close post (author only) *@
                    @if (currentUserId == Model.AuthorId && Model.Status == PostStatus.Active)
                    {
                        <form asp-action="Close" asp-route-id="@Model.PostId"
                              method="post" class="d-inline"
                              onsubmit="return confirm('@L["PostCloseConfirm"]')">
                            <button class="btn btn-sm btn-outline-secondary">@L["PostClose"]</button>
                        </form>
                    }

                    @* Close as admin, with a required comment (someone else's post) *@
                    @if (Model.CanCloseAsAdmin)
                    {
                        <form asp-action="Close" asp-route-id="@Model.PostId" method="post" class="d-inline"
                              onsubmit="var r=prompt('Λόγος κλεισίματος (θα φανεί στον συγγραφέα):'); if(!r){return false;} this.querySelector('[name=reason]').value=r;">
                            <input type="hidden" name="reason" value="" />
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-lock me-1"></i>Κλείσιμο (Admin)
                            </button>
                        </form>
                    }

                    @* View Profile (caregivers who have reacted) *@
                    @if (Model.ViewerIsCaregiver && Model.AuthorId != currentUserId)
                    {
                        <a id="view-profile-btn"
                           href="/profile/@Model.AuthorId"
                           class="btn btn-sm btn-outline-info @(Model.CanViewAuthorProfile ? "" : "d-none")">
                            <i class="fa-solid fa-user me-1"></i>@L["PostViewProfile"]
                        </a>
                    }
                </div>
            </div>
        </div>

        @* OP Contact Info (shown to OP always, and to approved reactors) *@
        @if (Model.ShowOPContactInfo && !Model.CanEdit)
        {
            <div class="card mb-4 border-success">
                <div class="card-header bg-success bg-opacity-10 fw-semibold text-success">
                    <i class="fas fa-address-card me-2"></i>Στοιχεία Επικοινωνίας Συντάκτη
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.AuthorPhone))
                    {
                        <p class="mb-1"><i class="fas fa-phone me-2 text-muted"></i>@Model.AuthorPhone</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.AuthorEmail))
                    {
                        <p class="mb-1"><i class="fas fa-envelope me-2 text-muted"></i>@Model.AuthorEmail</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.AuthorAddress))
                    {
                        <p class="mb-1"><i class="fas fa-map-marker-alt me-2 text-muted"></i>@Model.AuthorAddress</p>
                    }
                </div>
            </div>
        }

        @* Waiting for approval notice (non-approved caregivers who have reacted) *@
        @if (Model.CurrentUserLiked && !Model.IsViewerApprovedReactor && !Model.CanEdit && Model.ViewerIsCaregiver)
        {
            <div class="alert alert-info mb-4">
                <i class="fas fa-clock me-2"></i>
                <strong>Αναμονή έγκρισης:</strong> Η αντίδρασή σας στάλθηκε στον συντάκτη.
                Μόλις εγκριθεί, θα έχετε πρόσβαση στα στοιχεία επικοινωνίας.
            </div>
        }

        @* Reactions panel — only shown to OP *@
        @if (Model.CanEdit && Model.ReactingUsers.Any())
        {
            <div class="card mb-4">
                <div class="card-header fw-semibold">
                    <i class="fas fa-heart me-2 text-danger"></i>Αντιδράσεις (@Model.ReactingUsers.Count)
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var reactor in Model.ReactingUsers)
                    {
                        <div class="list-group-item d-flex align-items-center gap-3 py-2">
                            <div class="flex-grow-1">
                                <a href="/profile/@reactor.UserId" class="fw-semibold text-decoration-none">@reactor.UserName</a>
                                @if (reactor.IsCaregiver)
                                {
                                    <span class="badge bg-primary ms-1">Φροντιστής</span>
                                }
                                @if (reactor.AverageRating > 0)
                                {
                                    @await Html.PartialAsync("_StarRating", reactor.AverageRating,
                                        new ViewDataDictionary(ViewData) { ["StarCount"] = reactor.ReviewCount })
                                }
                                <small class="text-muted d-block">@reactor.ReactedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                            @if (reactor.IsApproved)
                            {
                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Εγκεκριμένο</span>
                            }
                            else
                            {
                                <form asp-controller="Reactions" asp-action="ApproveReaction"
                                      asp-route-reactionId="@reactor.ReactionId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="fas fa-check me-1"></i>Έγκριση
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Replies (only shown on approved posts) *@
        @if (Model.ModerationStatus == ModerationStatus.Approved)
        {
        <h5 class="mb-3">@Model.Replies.Count @(Model.Replies.Count == 1 ? L["PostReplySingular"].Value : L["PostReplyPlural"].Value)</h5>

        @if (!Model.Replies.Any())
        {
            <p class="text-muted">@L["PostNoReplies"]</p>
        }

        @foreach (var reply in Model.Replies)
        {
            <div class="card mb-2 @(reply.AuthorId == currentUserId ? "border-primary" : "")"
                 id="reply-@reply.Id">
                <div class="card-body py-2 px-3">
                    <div id="reply-text-@reply.Id">
                        <p class="mb-1" style="white-space: pre-wrap">@reply.Body</p>
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted">
                                @reply.AuthorName
                                @if (reply.AuthorIsCaregiver && reply.AuthorAverageRating > 0)
                                {
                                    @await Html.PartialAsync("_StarRating", reply.AuthorAverageRating,
                                        new ViewDataDictionary(ViewData) { ["StarCount"] = reply.AuthorReviewCount })
                                }
                                · @reply.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                @if (reply.EditedAt.HasValue)
                                {
                                    <span class="fst-italic">@L["PostEditedLabel"]</span>
                                }
                            </small>
                            @if (reply.CanEdit)
                            {
                                <button class="btn btn-sm btn-link text-muted p-0"
                                        onclick="showReplyEdit(@reply.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reply.Body)))">
                                    <i class="fas fa-edit"></i> @L["BtnEdit"]
                                </button>
                            }
                        </div>
                    </div>

                    @if (reply.CanEdit)
                    {
                        <div id="reply-edit-@reply.Id" style="display:none;" class="mt-2">
                            <form asp-action="ReplyEdit" asp-route-replyId="@reply.Id" method="post">
                                @Html.AntiForgeryToken()
                                <textarea name="body" class="form-control mb-2" rows="3">@reply.Body</textarea>
                                <button type="submit" class="btn btn-sm btn-primary me-1">@L["BtnSave"]</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="hideReplyEdit(@reply.Id)">@L["BtnCancel"]</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
        } @* end ModerationStatus == Approved replies section *@

        @* Reply form *@
        @if (Model.Status == PostStatus.Active && Model.ModerationStatus == ModerationStatus.Approved)
        {
            if (User.Identity?.IsAuthenticated == true)
            {
                <div class="card mt-4">
                    <div class="card-body">
                        <h6 class="card-title">@L["PostLeaveReply"]</h6>

                        <div class="alert alert-light border small mb-3" role="alert">
                            @L["PostModerationNotice"]
                        </div>

                        <form asp-action="Reply" asp-route-id="@Model.PostId" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                            <div class="mb-3">
                                <textarea asp-for="ReplyBody" class="form-control" rows="4"
                                          placeholder="@L["PostReplyPlaceholder"]"></textarea>
                                <span asp-validation-for="ReplyBody" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@L["PostSubmitReply"]</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light border mt-4">
                    <a asp-controller="Account" asp-action="Login">@L["NavLogin"]</a> @L["PostToReply"]
                </div>
            }
        }
        else
        {
            <div class="alert alert-secondary mt-4">
                @L["PostClosedMsg"]
                @if (!string.IsNullOrEmpty(Model.ClosedReason))
                {
                    <div class="mt-2"><strong>Σχόλιο διαχειριστή:</strong> @Model.ClosedReason</div>
                }
            </div>
        }

        <div class="mt-3">
            <a asp-action="Index" class="text-muted small">@L["PostBackToAll"]</a>
        </div>
    </div>
</div>
</div>@* /container *@

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        // Reaction toggle
        document.getElementById('react-btn')?.addEventListener('click', async function() {
            const btn = this;
            if (btn.disabled) return;
            btn.disabled = true;
            const postId = btn.dataset.postId;

            try {
                const resp = await fetch(`/reactions/toggle/${postId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getToken()
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(getToken())}`
                });

                if (!resp.ok) {
                    alert('Request failed. Please try again.');
                    return;
                }
                const data = await resp.json();
                if (data.error) { alert(data.error); return; }

                document.getElementById('react-count').textContent = data.count;
                if (data.liked) {
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-primary');
                    document.getElementById('view-profile-btn')?.classList.remove('d-none');
                } else {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                }
            } catch {
                alert('Network error. Please try again.');
            } finally {
                btn.disabled = false;
            }
        });

        // Save toggle
        document.getElementById('save-btn')?.addEventListener('click', async function() {
            const btn = this;
            if (btn.disabled) return;
            btn.disabled = true;
            const postId = btn.dataset.postId;

            try {
                const resp = await fetch(`/saved/toggle/${postId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getToken()
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(getToken())}`
                });

                if (!resp.ok) {
                    alert('Request failed. Please try again.');
                    return;
                }
                const data = await resp.json();

                if (data.saved) {
                    btn.classList.remove('btn-outline-warning');
                    btn.classList.add('btn-warning');
                    btn.querySelector('i').nextSibling.textContent = ' @L["BtnSaved"]';
                } else {
                    btn.classList.remove('btn-warning');
                    btn.classList.add('btn-outline-warning');
                    btn.querySelector('i').nextSibling.textContent = ' @L["BtnSave"]';
                }
            } catch {
                alert('Network error. Please try again.');
            } finally {
                btn.disabled = false;
            }
        });
        </script>
    }

    <script>
    function showReplyEdit(id, body) {
        document.getElementById('reply-text-' + id).style.display = 'none';
        document.getElementById('reply-edit-' + id).style.display = '';
    }
    function hideReplyEdit(id) {
        document.getElementById('reply-text-' + id).style.display = '';
        document.getElementById('reply-edit-' + id).style.display = 'none';
    }
    </script>
}
