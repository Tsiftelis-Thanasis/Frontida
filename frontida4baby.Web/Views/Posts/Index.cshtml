@model frontida4baby.Web.Models.ViewModels.PostListViewModel
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = L["PostBoardTitle"].Value;
}

@* ─── Page Header *@
<div class="page-header">
    <div class="container">
        <h1>@L["PostBoardTitle"]</h1>
        <p>@L["PostBoardSubtitle"]</p>
    </div>
</div>

<div class="container pb-5">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Caregiver Requests</h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Post a Request</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
            Log in to post a request
        </a>
    }
</div>

@if (TempData["PostStatus"] as string == "Pending")
{
    <div class="alert alert-info">
        Your post is under review and will appear once approved by a moderator.
    </div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-sm-4">
        <select name="ServiceType" class="form-select" asp-items="Html.GetEnumSelectList<ServiceType>()">
            <option value="">All service types</option>
        </select>
    </div>
    <div class="col-sm-4">
        <input name="City" value="@Model.City" placeholder="City" class="form-control" />
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
    </div>
    @if (Model.ServiceType.HasValue || !string.IsNullOrEmpty(Model.City))
    {
        <div class="col-sm-2">
            <a asp-action="Index" class="btn btn-link w-100">Clear</a>
        </div>
    }
</form>

@if (!Model.Posts.Any())
{
    <div class="text-muted text-center py-5">
        <p class="fs-5">No requests found.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">Be the first to post</a>
        }
    </div>
}
else
{
    <div class="list-group">
        @foreach (var post in Model.Posts)
        {
            <a asp-action="Details" asp-route-id="@post.Id"
               class="list-group-item list-group-item-action py-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1 fw-semibold">@post.Title</h6>
                        <small class="text-muted">
                            @post.AuthorName
                            @if (post.ServiceType.HasValue)
                            {
                                <span class="badge bg-secondary ms-1">@post.ServiceType</span>
                            }
                            @if (!string.IsNullOrEmpty(post.City))
                            {
                                <span class="ms-1">· @post.City</span>
                            }
                        </small>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">
                            @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </small>
                        <small class="text-muted">
                            @post.ReplyCount
                            @(post.ReplyCount == 1 ? "reply" : "replies")
                        </small>
                    </div>
                </div>
            </a>
        }
    </div>
}
</div>@* /container *@
