@model frontida4baby.Web.Models.ViewModels.PostListViewModel
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = L["PostBoardTitle"].Value;
}

@* ─── Page Header *@
<div class="page-header">
    <div class="container">
        <h1>@L["PostBoardTitle"]</h1>
        <p>@L["PostBoardSubtitle"]</p>
    </div>
</div>

<div class="container pb-5">

@* ─── AI Moderation Notice ──────────────────────────────────────────────── *@
<div class="d-flex align-items-center gap-3 rounded-3 border border-primary-subtle bg-primary-subtle p-3 mb-4">
    <i class="fa-solid fa-robot fa-lg text-primary flex-shrink-0"></i>
    <div class="small">
        <span class="fw-semibold text-primary">@L["AiModerationBadge"]</span>
        &mdash; @L["AiModerationDesc"]
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@L["PostCaregiverRequests"]</h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">@L["PostNewRequest"]</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
            @L["PostLoginToPost"]
        </a>
    }
</div>

@if (TempData["PostStatus"] as string == "Pending")
{
    <div class="alert alert-info">
        @L["PostPendingNotice"]
    </div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-sm-4">
        <select name="ServiceType" class="form-select" asp-items="Html.GetEnumSelectList<ServiceType>()">
            <option value="">@L["PostAllServiceTypes"]</option>
        </select>
    </div>
    <div class="col-sm-4">
        <input name="City" value="@Model.City" placeholder="@L["FilterCity"]" class="form-control" />
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@L["HeroBtnSearch"]</button>
    </div>
    @if (Model.ServiceType.HasValue || !string.IsNullOrEmpty(Model.City))
    {
        <div class="col-sm-2">
            <a asp-action="Index" class="btn btn-link w-100">@L["FilterClear"]</a>
        </div>
    }
</form>

@if (!Model.Posts.Any())
{
    <div class="text-muted text-center py-5">
        <p class="fs-5">@L["PostNoResults"]</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">@L["PostBeFirst"]</a>
        }
    </div>
}
else
{
    <div class="list-group">
        @foreach (var post in Model.Posts)
        {
            <a asp-action="Details" asp-route-id="@post.Id"
               class="list-group-item list-group-item-action py-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1 fw-semibold">@post.Title</h6>
                        <small class="text-muted">
                            @post.AuthorName
                            @if (post.AuthorIsCaregiver && post.AuthorAverageRating > 0)
                            {
                                @await Html.PartialAsync("_StarRating", post.AuthorAverageRating,
                                    new ViewDataDictionary(ViewData) { ["StarCount"] = post.AuthorReviewCount })
                            }
                            @if (post.ServiceType.HasValue)
                            {
                                <span class="badge bg-secondary ms-1">@post.ServiceType</span>
                            }
                            @if (!string.IsNullOrEmpty(post.City))
                            {
                                <span class="ms-1">· @post.City</span>
                            }
                        </small>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">
                            @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </small>
                        <small class="text-muted">
                            @post.ReplyCount
                            @(post.ReplyCount == 1 ? L["PostReplySingular"].Value : L["PostReplyPlural"].Value)
                        </small>
                    </div>
                </div>
            </a>
        }
    </div>
}
</div>@* /container *@
