@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <title>@ViewData["Title"] – frontida4all</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/stitch-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stitch-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @{ var siteBannerMessage = Configuration["SiteBanner:Message"]; }
    @if (!string.IsNullOrWhiteSpace(siteBannerMessage))
    {
        <div class="site-banner-warning">
            <i class="fas fa-triangle-exclamation me-2"></i>@siteBannerMessage
        </div>
    }

    @* ─── Navbar ──────────────────────────────────────────────────────────── *@
    <header>
        <nav class="navbar navbar-expand-lg st-nav">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    frontida4all
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">@L["NavHome"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Posts" asp-action="Index">@L["NavFindHelp"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Caregivers" asp-action="Index">@L["NavBrowse"]</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">

                        @* Language switcher *@
                        <li class="nav-item">
                            @{
                                var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                                var returnPath  = $"{Context.Request.Path}{Context.Request.QueryString}";
                            }
                            <div class="lang-switcher">
                                <form asp-controller="Language" asp-action="Set" method="post" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="@returnPath" />
                                    <input type="hidden" name="culture"   value="el" />
                                    <button type="submit" class="lang-btn @(currentLang == "el" ? "active" : "")">ΕΛ</button>
                                </form>
                                <span class="lang-sep">|</span>
                                <form asp-controller="Language" asp-action="Set" method="post" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="@returnPath" />
                                    <input type="hidden" name="culture"   value="en" />
                                    <button type="submit" class="lang-btn @(currentLang == "en" ? "active" : "")">EN</button>
                                </form>
                            </div>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (!User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                        <span class="material-symbols-outlined me-1" style="font-size:1.1rem">dashboard</span>@L["NavDashboard"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Subscription" asp-action="Index">
                                        <span class="material-symbols-outlined me-1" style="font-size:1.1rem">star</span>@L["NavSubscription"]
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link fw-bold dropdown-toggle" style="color:var(--st-error)!important"
                                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="material-symbols-outlined me-1" style="font-size:1.1rem">shield</span>Admin
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                                <span class="material-symbols-outlined me-2 text-danger" style="font-size:1.1rem">speed</span>Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-primary)">group</span>Χρήστες
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Posts">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-primary)">article</span>Αγγελίες
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Logs">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-primary)">list_alt</span>Logs
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Tickets">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-primary)">support_agent</span>Αιτήματα Υποστήριξης
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Invoices">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-primary)">receipt_long</span>Τιμολόγια
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Moderation" asp-action="Queue">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-tertiary)">gavel</span>@L["NavModeration"]
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Moderation" asp-action="Logs">
                                                <span class="material-symbols-outlined me-2" style="font-size:1.1rem;color:var(--st-tertiary)">fact_check</span>Ιστορικό Εποπτείας
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link px-0">@L["NavLogout"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">@L["NavLogin"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm"
                                   asp-controller="Account" asp-action="Register">@L["NavRegister"]</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* ─── Main Content ─────────────────────────────────────────────────────── *@
    <main>
        @RenderBody()
    </main>

    @* ─── Footer ───────────────────────────────────────────────────────────── *@
    <footer class="st-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="footer-brand">frontida4all</div>
                    <p class="footer-tagline mt-2">@L["FtrTagline"]</p>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>@L["FtrLinks"]</h6>
                    <a asp-controller="Home"       asp-action="Index">@L["NavHome"]</a>
                    <a asp-controller="Posts"      asp-action="Index">@L["NavFindHelp"]</a>
                    <a asp-controller="Caregivers" asp-action="Index">@L["NavBrowse"]</a>
                </div>

                <div class="col-6 col-lg-3">
                    <h6>@L["FtrServices"]</h6>
                    <a asp-controller="Caregivers" asp-action="Index" asp-route-ServiceType="Childcare">@L["SvcChildcareTitle"]</a>
                    <a asp-controller="Caregivers" asp-action="Index" asp-route-ServiceType="ElderlyCare">@L["SvcElderlyTitle"]</a>
                    <a asp-controller="Caregivers" asp-action="Index" asp-route-ServiceType="Tutoring">@L["SvcTutoringTitle"]</a>
                    <a asp-controller="Caregivers" asp-action="Index" asp-route-ServiceType="Housekeeping">@L["SvcHousekeepingTitle"]</a>
                    <a asp-controller="Caregivers" asp-action="Index" asp-route-ServiceType="PetCare">@L["SvcPetTitle"]</a>
                </div>

                <div class="col-lg-3">
                    <h6>frontida4all</h6>
                    <a asp-controller="Home" asp-action="Privacy">@L["FtrPrivacy"]</a>
                    <a asp-controller="Home" asp-action="TermsOfService">Όροι Χρήσης</a>
                    <a asp-controller="Home" asp-action="Disclaimer">Αποποίηση Ευθύνης</a>
                    <a asp-controller="Home" asp-action="AiReviewPolicy">Πολιτική AI</a>
                    <a asp-controller="Home" asp-action="Gdpr">GDPR</a>
                    <a asp-controller="Home" asp-action="Support">Επικοινωνία</a>
                    @if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <a asp-controller="Account" asp-action="Register">@L["NavRegister"]</a>
                        <a asp-controller="Account" asp-action="Login">@L["NavLogin"]</a>
                    }
                </div>
            </div>

            <div class="footer-bottom">@L["FtrCopyright"]</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_DisclaimerPartial")
    @await Html.PartialAsync("_CookieConsentPartial")
</body>
</html>
