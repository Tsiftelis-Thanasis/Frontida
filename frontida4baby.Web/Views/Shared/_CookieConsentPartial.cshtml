<div id="cookie-toast" class="cookie-toast" style="display:none;" role="alert" aria-live="polite">
    <div class="cookie-toast-icon">
        <i class="fas fa-cookie-bite"></i>
    </div>
    <div class="cookie-toast-body">
        <strong>@L["CookieTitle"]</strong>
        <p class="mb-0 mt-1">@L["CookieMessage"] <a asp-controller="Home" asp-action="Privacy" class="cookie-link">@L["CookieLearnMore"]</a></p>
    </div>
    <button id="cookie-accept" class="cookie-accept-btn" aria-label="@L["CookieAccept"]">
        @L["CookieAccept"]
    </button>
</div>

<style>
.cookie-toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    max-width: 340px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    display: flex;
    align-items: flex-start;
    gap: .85rem;
    padding: 1rem 1.1rem;
    z-index: 1050;
    animation: cookie-slide-in .35s ease;
}
@@keyframes cookie-slide-in {
    from { opacity: 0; transform: translateY(1.5rem); }
    to   { opacity: 1; transform: translateY(0); }
}
.cookie-toast-icon {
    font-size: 1.4rem;
    color: #f59e0b;
    flex-shrink: 0;
    margin-top: 2px;
}
.cookie-toast-body {
    flex: 1;
    font-size: .85rem;
    color: #374151;
    line-height: 1.45;
}
.cookie-toast-body strong {
    font-size: .9rem;
    color: #111827;
}
.cookie-link {
    color: var(--bs-primary, #4f46e5);
    text-decoration: underline;
    white-space: nowrap;
}
.cookie-accept-btn {
    flex-shrink: 0;
    align-self: flex-end;
    background: var(--bs-primary, #4f46e5);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: .35rem .75rem;
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .2s;
}
.cookie-accept-btn:hover { opacity: .88; }
@@media (max-width: 480px) {
    .cookie-toast {
        left: 1rem;
        right: 1rem;
        max-width: none;
        bottom: 1rem;
    }
}
</style>

<script>
(function () {
    if (localStorage.getItem('cookieConsent')) return;
    var toast = document.getElementById('cookie-toast');
    setTimeout(function () { toast.style.display = 'flex'; }, 800);
    document.getElementById('cookie-accept').addEventListener('click', function () {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity .25s';
        setTimeout(function () { toast.style.display = 'none'; }, 260);
        localStorage.setItem('cookieConsent', '1');
    });
})();
</script>
