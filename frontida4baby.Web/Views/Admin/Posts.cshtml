@model List<frontida4baby.Web.Models.Entities.Post>
@using frontida4baby.Web.Models.Entities
@{
    ViewData["Title"] = "Διαχείριση Αγγελιών";
    int page = ViewBag.Page;
    int total = ViewBag.Total;
    var statusFilter = ViewBag.StatusFilter as ModerationStatus?;
}

<div class="container py-4">
    <h2 class="mb-4"><i class="fas fa-file-alt me-2"></i>Αγγελίες (@total)</h2>

    <div class="mb-3 d-flex gap-2">
        <a asp-action="Posts" class="btn btn-sm @(statusFilter == null ? "btn-primary" : "btn-outline-secondary")">Όλες</a>
        <a asp-action="Posts" asp-route-status="@ModerationStatus.PendingReview"
           class="btn btn-sm @(statusFilter == ModerationStatus.PendingReview ? "btn-warning" : "btn-outline-warning")">Εκκρεμείς</a>
        <a asp-action="Posts" asp-route-status="@ModerationStatus.Approved"
           class="btn btn-sm @(statusFilter == ModerationStatus.Approved ? "btn-success" : "btn-outline-success")">Εγκεκριμένες</a>
        <a asp-action="Posts" asp-route-status="@ModerationStatus.Rejected"
           class="btn btn-sm @(statusFilter == ModerationStatus.Rejected ? "btn-danger" : "btn-outline-danger")">Απορριφθείσες</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Τίτλος</th>
                    <th>Χρήστης</th>
                    <th>Status</th>
                    <th>Ημερομηνία</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td class="text-truncate" style="max-width:200px">@post.Title</td>
                        <td><small>@post.AuthorUser?.Email</small></td>
                        <td>
                            <span class="badge @(post.ModerationStatus == ModerationStatus.Approved ? "bg-success" :
                                                  post.ModerationStatus == ModerationStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">
                                @post.ModerationStatus
                            </span>
                        </td>
                        <td><small>@post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
                        <td>
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="btn btn-sm btn-outline-primary">Προβολή</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
