@model List<frontida4baby.Web.Models.Entities.Invoice>
@{
    ViewData["Title"] = "Τιμολόγια";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0"><i class="fas fa-file-invoice me-2"></i>Τιμολόγια (@Model.Count)</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Dashboard
        </a>
    </div>

    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        Αυτά είναι τοπικά αρχεία ετοιμότητας για <strong>myDATA</strong> — δεν έχουν διαβιβαστεί στην ΑΑΔΕ.
        Η πραγματική διαβίβαση απαιτεί τα στοιχεία της εγγεγραμμένης εταιρείας και διαπιστευτήρια API,
        τα οποία θα προστεθούν μόλις ολοκληρωθεί η σύσταση της εταιρείας από τον λογιστή σας.
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">Δεν υπάρχουν τιμολόγια ακόμα.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Αριθμός</th>
                        <th>Ημερομηνία</th>
                        <th>Αγοραστής</th>
                        <th class="text-end">Σύνολο</th>
                        <th>Πωλητής (ΑΦΜ)</th>
                        <th>Stripe Invoice</th>
                        <th>myDATA MARK</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td class="font-monospace">@inv.Number</td>
                            <td><small>@inv.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
                            <td>
                                @inv.BuyerName
                                <br /><small class="text-muted">@inv.BuyerEmail</small>
                            </td>
                            <td class="text-end fw-semibold">@inv.TotalAmount.ToString("N2") @inv.Currency.ToUpperInvariant()</td>
                            <td><small>@inv.SellerName<br />@inv.SellerVatNumber</small></td>
                            <td><small class="text-muted font-monospace">@inv.StripeInvoiceId</small></td>
                            <td>
                                @if (string.IsNullOrEmpty(inv.MyDataMark))
                                {
                                    <span class="badge bg-secondary">Εκκρεμεί</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@inv.MyDataMark</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
