@model List<frontida4baby.Web.Models.ViewModels.PaymentViewModel>
@{
    ViewData["Title"] = "Πληρωμές";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0"><i class="fas fa-credit-card me-2"></i>Πληρωμές (@Model.Count)</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Dashboard
        </a>
    </div>

    @if (ViewBag.StripeDisabled == true)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Το Stripe δεν είναι ενεργοποιημένο. Ενεργοποιήστε το στο <code>appsettings.json</code> (<code>Stripe:Enabled = true</code>).
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Δεν βρέθηκαν ολοκληρωμένες πληρωμές.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ημερομηνία</th>
                        <th>Χρήστης</th>
                        <th>Email</th>
                        <th class="text-end">Ποσό</th>
                        <th>Κατάσταση</th>
                        <th>Invoice ID</th>
                        <th class="text-center">Λήψη</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <small>@p.PaidAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(p.UserName) ? "–" : p.UserName)</td>
                            <td>
                                <small class="text-muted">@p.UserEmail</small>
                            </td>
                            <td class="text-end fw-semibold">
                                @p.Amount.ToString("N2") @p.Currency
                            </td>
                            <td>
                                <span class="badge bg-success">Πληρώθηκε</span>
                            </td>
                            <td>
                                <small class="text-muted font-monospace">@p.InvoiceId</small>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (!string.IsNullOrEmpty(p.InvoicePdfUrl))
                                    {
                                        <a href="@Url.Action("DownloadInvoice", "Admin", new { id = p.InvoiceId })"
                                           target="_blank"
                                           class="btn btn-outline-primary"
                                           title="Λήψη Τιμολογίου PDF">
                                            <i class="fas fa-file-pdf me-1"></i>Τιμολόγιο
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary" disabled title="Δεν διαθέσιμο">
                                            <i class="fas fa-file-pdf me-1"></i>Τιμολόγιο
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(p.HostedInvoiceUrl))
                                    {
                                        <a href="@Url.Action("DownloadReceipt", "Admin", new { id = p.InvoiceId })"
                                           target="_blank"
                                           class="btn btn-outline-success"
                                           title="Προβολή Απόδειξης (Stripe)">
                                            <i class="fas fa-receipt me-1"></i>Απόδειξη
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary" disabled title="Δεν διαθέσιμο">
                                            <i class="fas fa-receipt me-1"></i>Απόδειξη
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted small">
            <i class="fas fa-info-circle me-1"></i>
            Εμφανίζονται έως 100 πιο πρόσφατες πληρωμές από το Stripe.
        </div>
    }
</div>
