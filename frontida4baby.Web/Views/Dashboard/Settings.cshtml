@model frontida4baby.Web.Models.ViewModels.UserSettingsViewModel
@{
    ViewData["Title"] = "Ρυθμίσεις Λογαριασμού";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <h2 class="mb-4"><i class="fas fa-cog me-2 text-primary"></i>Ρυθμίσεις</h2>

            @if (TempData["SettingsSaved"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check me-2"></i>Οι αλλαγές αποθηκεύτηκαν.
                </div>
            }

            <form asp-action="Settings" method="post">
                <div asp-validation-summary="All" class="alert alert-danger small"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" type="tel" />
                </div>

                <div class="mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Bio" class="form-label"></label>
                    <textarea asp-for="Bio" class="form-control" rows="4"
                              placeholder="Παρουσιάστε τον εαυτό σας..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Πίσω</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
