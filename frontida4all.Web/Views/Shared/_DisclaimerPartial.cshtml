<div id="disclaimer-banner" class="st-disclaimer-banner" style="display:none;">
    <div class="container d-flex align-items-center justify-content-between py-2">
        <div class="d-flex align-items-center gap-2">
            <span class="material-symbols-outlined" style="font-size:1.2rem;color:var(--st-primary)">smart_toy</span>
            <small>
                Η πλατφόρμα δεν ευθύνεται για αλληλεπιδράσεις μεταξύ χρηστών.
                Το περιεχόμενο εποπτεύεται από <strong>Claude AI</strong>.
                <a href="/disclaimer" class="ms-1">Μάθετε περισσότερα</a>
            </small>
        </div>
        <button type="button" class="btn-close btn-close-sm ms-3" id="disclaimer-close" aria-label="Κλείσιμο"></button>
    </div>
</div>

<script>
(function () {
    var banner = document.getElementById('disclaimer-banner');
    var closeBtn = document.getElementById('disclaimer-close');
    if (!localStorage.getItem('disclaimerDismissed')) {
        banner.style.display = '';
    }
    closeBtn.addEventListener('click', function () {
        banner.style.display = 'none';
        localStorage.setItem('disclaimerDismissed', '1');
    });
})();
</script>
