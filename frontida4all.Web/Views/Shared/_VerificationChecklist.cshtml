@model frontida4all.Web.Services.VerificationSummary
@{
    var compact = ViewData["Compact"] as bool? ?? false;
    string Chip(bool on, string label) => on
        ? $"<li class=\"vf-chip\"><i class=\"fa-solid fa-check\"></i>{label}</li>"
        : $"<li class=\"vf-chip off\"><i class=\"fa-regular fa-circle\"></i>{label}</li>";
}
<div class="vf-box">
    @if (!Model.IsFullyVerified)
    {
        <div class="vf-notice @(compact ? "mb-1" : "mb-2")">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            <strong>Προφίλ όχι πλήρως επαληθευμένο.</strong>
            @if (!compact)
            {
                <span>Λείπουν: @string.Join(", ", Model.Missing()). Ελέγξτε προσεκτικά πριν αποφασίσετε.</span>
            }
        </div>
    }
    <ul class="vf-list">
        @Html.Raw(Chip(Model.EmailConfirmed, "Email"))
        @Html.Raw(Chip(Model.PhoneConfirmed, "Κινητό"))
        @Html.Raw(Chip(Model.AddressApproved, "Διεύθυνση"))
        @Html.Raw(Chip(Model.IdentityVerified, "Ταυτότητα"))
        @Html.Raw(Chip(Model.CriminalRecordApproved,
            Model.CriminalRecordApproved && Model.CriminalRecordExpiresAt != null
                ? $"Ποινικό μητρώο (έως {Model.CriminalRecordExpiresAt:MM/yyyy})"
                : "Ποινικό μητρώο"))
    </ul>
    @if (!compact)
    {
        <div class="small text-muted mt-2">
            Η επαλήθευση δεν αποτελεί εγγύηση για τη συμπεριφορά ή την καταλληλότητα. Ελέγξτε πάντα τα στοιχεία και τις συστάσεις μόνοι σας.
        </div>
    }
</div>
