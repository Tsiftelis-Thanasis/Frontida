@model frontida4all.Web.Services.VerificationSummary
@{
    var compact = ViewData["Compact"] as bool? ?? false;
    string Chip(bool on, string label) => on
        ? $"<li class=\"vf-chip\"><i class=\"fa-solid fa-check\"></i>{label}</li>"
        : $"<li class=\"vf-chip off\"><i class=\"fa-regular fa-circle\"></i>{label}</li>";
}
<div class="vf-box">
    @if (!Model.IsFullyVerified)
    {
        <div class="vf-notice @(compact ? "mb-1" : "mb-2")">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            <strong>@L["VfChecklistNotFull"]</strong>
            @if (!compact)
            {
                <span>@L["VfMissingLabel"] @string.Join(", ", Model.MissingKeys().Select(k => L[k].Value)). @L["VfCheckCarefully"]</span>
            }
        </div>
    }
    <ul class="vf-list">
        @Html.Raw(Chip(Model.EmailConfirmed, L["VfChipEmail"].Value))
        @Html.Raw(Chip(Model.PhoneConfirmed, L["VfChipPhone"].Value))
        @Html.Raw(Chip(Model.AddressApproved, L["VfChipAddress"].Value))
        @Html.Raw(Chip(Model.IdentityVerified, L["VfChipIdentity"].Value))
        @Html.Raw(Chip(Model.CriminalRecordApproved,
            Model.CriminalRecordApproved && Model.CriminalRecordExpiresAt != null
                ? string.Format(L["VfChipCriminalUntil"].Value, Model.CriminalRecordExpiresAt?.ToString("MM/yyyy"))
                : L["VfChipCriminal"].Value))
    </ul>
    @if (!compact)
    {
        <div class="small text-muted mt-2">
            @L["VfDisclaimerShort"]
        </div>
    }
</div>
