@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="container py-5 text-center">
    <i class="fa-solid fa-triangle-exclamation fa-3x text-danger mb-3 d-block"></i>
    <h1 class="text-danger">Error</h1>
    <h2 class="h5 text-danger">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="mt-3">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="fa-solid fa-house me-1"></i> Go Home
    </a>
</div>
