@model bool
@{
    ViewData["Title"] = Model ? "Email επιβεβαιώθηκε" : "Σφάλμα επιβεβαίωσης";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">

        @if (Model)
        {
            <i class="fa-solid fa-circle-check fa-3x text-success mb-3 d-block"></i>
            <h2>Email επιβεβαιώθηκε!</h2>
            <p class="subtitle">Ο λογαριασμός σου είναι πλέον πλήρως ενεργός.</p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">
                    <i class="fas fa-tachometer-alt me-2"></i>Μετάβαση στο Dashboard
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">
                    <i class="fas fa-sign-in-alt me-2"></i>Σύνδεση
                </a>
            }
        }
        else
        {
            <i class="fa-solid fa-circle-xmark fa-3x text-danger mb-3 d-block"></i>
            <h2>Ο σύνδεσμος δεν είναι έγκυρος</h2>
            <p class="subtitle">
                Ο σύνδεσμος επιβεβαίωσης έχει λήξει ή δεν είναι έγκυρος.
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="ResendVerification" asp-controller="Account" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-rotate-right me-1"></i>Αποστολή νέου συνδέσμου
                    </button>
                </form>
            }
            else
            {
                <p class="text-muted small mt-3">
                    Συνδέσου στον λογαριασμό σου για να στείλεις νέο σύνδεσμο επιβεβαίωσης.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mt-2">
                    Σύνδεση
                </a>
            }
        }

    </div>
</div>
