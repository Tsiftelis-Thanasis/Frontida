@{
    ViewData["Title"] = "Password Reset";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <i class="fa-solid fa-check-circle fa-2x text-success mb-3 d-block"></i>
        <h2>Password Reset Successful</h2>
        <p class="subtitle">Your password has been reset. You can now log in with your new password.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">Login</a>
    </div>
</div>
