@model List<frontida4all.Web.Models.Entities.AppLog>
@using frontida4all.Web.Models.Entities
@{
    ViewData["Title"] = "Application Logs";
    int page = ViewBag.Page;
    int total = ViewBag.Total;
    var level = ViewBag.Level as AppLogLevel?;
    string? category = ViewBag.Category;
    var categories = (List<string>)ViewBag.Categories;
    int pageSize = 50;
    int pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
}

<div class="container py-4">
    <h2 class="mb-4"><i class="fas fa-list-alt me-2"></i>Application Logs (@total)</h2>

    <form method="get" asp-action="Logs" class="row g-2 mb-4">
        <div class="col-auto">
            <select name="level" class="form-select form-select-sm">
                <option value="">Όλα τα επίπεδα</option>
                <option value="@AppLogLevel.Info" selected="@(level == AppLogLevel.Info)">Info</option>
                <option value="@AppLogLevel.Warning" selected="@(level == AppLogLevel.Warning)">Warning</option>
                <option value="@AppLogLevel.Error" selected="@(level == AppLogLevel.Error)">Error</option>
            </select>
        </div>
        <div class="col-auto">
            <select name="category" class="form-select form-select-sm">
                <option value="">Όλες οι κατηγορίες</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat" selected="@(category == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Φίλτρο</button>
            <a asp-action="Logs" class="btn btn-sm btn-outline-secondary ms-1">Καθαρισμός</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Επίπεδο</th>
                    <th>Κατηγορία</th>
                    <th>Μήνυμα</th>
                    <th>Χρήστης</th>
                    <th>Path</th>
                    <th>Ημερομηνία</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>
                            <span class="badge @(log.Level == AppLogLevel.Error ? "bg-danger" :
                                                  log.Level == AppLogLevel.Warning ? "bg-warning text-dark" : "bg-info text-dark")">
                                @log.Level
                            </span>
                        </td>
                        <td><small class="text-muted">@log.Category</small></td>
                        <td style="max-width:420px">
                            <div class="text-break">@log.Message</div>
                            @if (!string.IsNullOrWhiteSpace(log.Details))
                            {
                                <details class="small">
                                    <summary class="text-muted">Λεπτομέρειες</summary>
                                    <pre class="small bg-light p-2 mb-0 text-wrap">@log.Details</pre>
                                </details>
                            }
                        </td>
                        <td><small class="text-muted">@log.UserId</small></td>
                        <td><small class="text-muted">@log.RequestPath</small></td>
                        <td><small>@log.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm:ss")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (pageCount > 1)
    {
        <nav class="d-flex justify-content-between align-items-center">
            <span class="small text-muted">Σελίδα @(page) από @pageCount</span>
            <div class="btn-group btn-group-sm">
                @if (page > 1)
                {
                    <a class="btn btn-outline-secondary"
                       asp-action="Logs" asp-route-level="@level" asp-route-category="@category"
                       asp-route-dateFrom="@ViewBag.DateFrom" asp-route-dateTo="@ViewBag.DateTo"
                       asp-route-page="@(page - 1)">Προηγούμενη</a>
                }
                @if (page < pageCount)
                {
                    <a class="btn btn-outline-secondary"
                       asp-action="Logs" asp-route-level="@level" asp-route-category="@category"
                       asp-route-dateFrom="@ViewBag.DateFrom" asp-route-dateTo="@ViewBag.DateTo"
                       asp-route-page="@(page + 1)">Επόμενη</a>
                }
            </div>
        </nav>
    }
</div>
