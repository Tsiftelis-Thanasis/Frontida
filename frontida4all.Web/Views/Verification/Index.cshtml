@model frontida4all.Web.Controllers.VerificationPageViewModel
@using frontida4all.Web.Models.Entities
@using frontida4all.Web.Services
@{
    ViewData["Title"] = L["VfPageTitle"].Value;
    var s = Model.Summary;
    var phonePrefill = (TempData["VerifyPhone"] as string) ?? s.PhoneNumber;
    var codeSent = TempData["VerifyPhone"] != null;
    var today = DateTime.UtcNow.Date;
    var oldest = today.AddMonths(-Model.CriminalRecordValidityMonths).AddDays(1);
    var renewSoon = s.CriminalRecordExpiresAt != null && (s.CriminalRecordExpiresAt.Value - DateTime.UtcNow).TotalDays < 30;
}

<div class="container py-4" style="max-width:860px">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h2 class="mb-0">@L["VfPageTitle"]</h2>
        <span class="badge @(s.IsFullyVerified ? "bg-success" : "bg-secondary") fs-6">@s.CompletedSteps / @VerificationSummary.TotalSteps</span>
    </div>
    <p class="text-muted">
        @Html.Raw(L["VfIntro"].Value)
    </p>

    @if (TempData["VerifyMessage"] is string okMsg)
    {
        <div class="alert alert-success">@okMsg</div>
    }
    @if (TempData["VerifyError"] is string errMsg)
    {
        <div class="alert alert-danger">@errMsg</div>
    }

    @if (s.IsFullyVerified)
    {
        <div class="alert alert-success d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> @L["VfFullyVerified"]
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <strong>@L["VfNotFully"]</strong>
            @L["VfMissingLabel"] @string.Join(", ", s.MissingKeys().Select(k => L[k].Value)).
            @L["VfFamiliesNotified"]
        </div>
    }

    @* 1. Email *@
    <div class="card mb-3"><div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@L["VfEmailTitle"]</h5>
            <small class="text-muted">@L["VfEmailDesc"]</small>
        </div>
        @if (s.EmailConfirmed)
        {
            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>@L["VfConfirmed"]</span>
        }
        else
        {
            <form asp-controller="Account" asp-action="ResendVerification" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-primary btn-sm">@L["VfResendLink"]</button>
            </form>
        }
    </div></div>

    @* 2. Phone *@
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-1">@L["VfPhoneTitle"]</h5>
                <small class="text-muted">@L["VfPhoneDesc"]</small>
            </div>
            @if (s.PhoneConfirmed)
            {
                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>@s.PhoneNumber</span>
            }
        </div>
        @if (!s.PhoneConfirmed)
        {
            @if (!Model.SmsAvailable)
            {
                <p class="text-muted mb-0 mt-2">@L["VfSmsUnavailable"]</p>
            }
            else
            {
                <form asp-action="SendPhoneCode" method="post" class="row g-2 mt-2">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-8"><input name="phone" class="form-control" placeholder="69XXXXXXXX" value="@phonePrefill" required /></div>
                    <div class="col-sm-4"><button class="btn btn-primary w-100">@L["VfSendCode"]</button></div>
                </form>
                @if (codeSent)
                {
                    <form asp-action="VerifyPhone" method="post" class="row g-2 mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="phone" value="@phonePrefill" />
                        <div class="col-sm-8"><input name="code" class="form-control" placeholder="@L["VfSmsCode"]" inputmode="numeric" autocomplete="one-time-code" required /></div>
                        <div class="col-sm-4"><button class="btn btn-accent w-100">@L["VfConfirmBtn"]</button></div>
                    </form>
                }
            }
        }
    </div></div>

    @* 3. Address *@
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-1">@L["VfAddrTitle"]</h5>
                <small class="text-muted">@L["VfAddrDesc"]</small>
            </div>
            @if (s.AddressApproved)
            {
                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>@L["VfApprovedUntil"] @s.AddressExpiresAt?.ToString("dd/MM/yyyy")</span>
            }
            else if (s.AddressPending)
            {
                <span class="badge bg-warning text-dark">@L["VfInReview"]</span>
            }
            else if (s.AddressExpired)
            {
                <span class="badge bg-danger">@L["VfExpired"]</span>
            }
        </div>
        <p class="small mb-2 mt-2">@L["VfYourAddress"] <strong>@(string.IsNullOrWhiteSpace(Model.Address) ? L["VfAddressEmpty"].Value : Model.Address)</strong></p>
        @if (s.AddressRejectionReason != null && !s.AddressPending)
        {
            <div class="alert alert-danger py-2 small">@L["VfRejected"] @s.AddressRejectionReason</div>
        }
        @if (!s.AddressApproved && !s.AddressPending)
        {
            <form asp-action="UploadAddress" method="post" enctype="multipart/form-data" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-sm-8"><input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                <div class="col-sm-4"><button class="btn btn-primary w-100">@L["VfUpload"]</button></div>
            </form>
            <small class="text-muted">@string.Format(L["VfFileHint"].Value, Model.MaxFileSizeMb)</small>
        }
    </div></div>

    @* 4. Identity *@
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-1">@L["VfIdTitle"]</h5>
                <small class="text-muted">@L["VfIdDesc"]</small>
            </div>
            @switch (s.IdentityStatus)
            {
                case IdentityCheckStatus.Verified:
                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>@L["VfIdVerified"]</span>
                    break;
                case IdentityCheckStatus.Pending:
                    <span class="badge bg-warning text-dark">@L["VfIdPending"]</span>
                    break;
                case IdentityCheckStatus.Failed:
                    <span class="badge bg-danger">@L["VfIdFailed"]</span>
                    break;
            }
        </div>
        @if (s.IdentityStatus != IdentityCheckStatus.Verified)
        {
            @if (!Model.IdentityAvailable)
            {
                <p class="text-muted mb-0 mt-2">@L["VfIdUnavailable"]</p>
            }
            else
            {
                <form asp-action="StartIdentity" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary">@(s.IdentityStatus == IdentityCheckStatus.NotStarted ? L["VfIdStart"].Value : L["VfIdRetry"].Value)</button>
                </form>
            }
        }
    </div></div>

    @* 5. Criminal record *@
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-1">@L["VfCrTitle"]</h5>
                <small class="text-muted">
                    @string.Format(L["VfCrDesc"].Value, Model.CriminalRecordValidityMonths)
                </small>
            </div>
            @if (s.CriminalRecordApproved)
            {
                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>@L["VfValidUntil"] @s.CriminalRecordExpiresAt?.ToString("dd/MM/yyyy")</span>
            }
            else if (s.CriminalRecordPending)
            {
                <span class="badge bg-warning text-dark">@L["VfInReview"]</span>
            }
            else if (s.CriminalRecordExpired)
            {
                <span class="badge bg-danger">@L["VfExpired"]</span>
            }
        </div>
        @if (s.CriminalRecordUploadedAt != null)
        {
            <p class="small text-muted mb-1 mt-2">@L["VfLastUpload"] @s.CriminalRecordUploadedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        }
        @if (s.CriminalRecordRejectionReason != null && !s.CriminalRecordPending)
        {
            <div class="alert alert-danger py-2 small mt-2">@L["VfRejected"] @s.CriminalRecordRejectionReason</div>
        }
        @if (!s.CriminalRecordPending && (!s.CriminalRecordApproved || renewSoon))
        {
            <form asp-action="UploadCriminalRecord" method="post" enctype="multipart/form-data" class="row g-2 mt-1">
                @Html.AntiForgeryToken()
                <div class="col-md-5"><input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                <div class="col-md-4">
                    <input type="date" name="issuedOn" class="form-control" min="@oldest.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" required />
                    <small class="text-muted">@L["VfIssueDate"]</small>
                </div>
                <div class="col-md-3"><button class="btn btn-primary w-100">@L["VfUpload"]</button></div>
            </form>
        }
        <p class="small text-muted mt-3 mb-0">
            @L["VfPrivacyNote"]
        </p>
    </div></div>

    <p class="small text-muted">
        @L["VfDisclaimerLong"]
    </p>
</div>
